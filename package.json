{
  "name": "manish-jangir-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade engineering portfolio for Manish Jangir.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
