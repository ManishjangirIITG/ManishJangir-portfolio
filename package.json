  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.5",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
